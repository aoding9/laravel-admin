{
    "name": "aoding9/laravel-admin",
    "description": "Dcat admin fork based on PrintNow/dcat-admin — Laravel 10-13 / PHP 8.1+ (incl. 8.5)",
    "version": "2.4.3",
    "type": "library",
    "keywords": [
        "dcat",
        "laravel",
        "admin",
        "grid",
        "form",
        "laravel admin",
        "dcat admin"
    ],
    "homepage": "https://github.com/aoding9/dcat-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "aoding9",
            "email": "xy5217733@163.com"
        },
        {
            "name": "Shine",
            "email": "i@nowtime.cc"
        },
        {
            "name": "jqh",
            "email": "841324345@qq.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": "~10.0|~11.0|~12.0|~13.0",
        "spatie/eloquent-sortable": "^4.0|^5.0",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-zip": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "laravel/dusk": "^8.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6"
    },
    "replace": {
        "dcat/laravel-admin": "self.version",
        "printnow/laravel-admin": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Dcat\\Admin\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Dcat\\Admin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dcat\\Admin\\AdminServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
